# IPV64.net DDNS Konfiguration

# DynDNS Update Key von ipv64.net
# Zu finden unter: ipv64.net -> Mein Konto -> DynDNS -> Update Key
# WICHTIG: Das ist NICHT der Account-API-Key, sondern der Domain-spezifische Update-Key.
# Er hat oft das Format: ipv64.net/?key=XXXX oder nur XXXX direkt
DOMAIN_KEY="DeinDOMAINKEYHier"

# Basis-Domain auf IPV64.net
BASE_DOMAIN="DeineDomain.ipv64.net"

# Subdomains (nur der Präfix, ohne Base-Domain)
SUBDOMAINS=(
    "sub1"
    "sub2"
    "sub3"
    "sub4"
    "sub5"
    "sub6"
    "sub7"
    "sub8"
    "sub9"
    "sub10"
    "sub11"
    "sub12"
    "sub13"
    "sub14"
)

# Log-Datei
LOG_FILE="/var/log/ddns_update.log"

# Maximale Log-Größe in Zeilen
MAX_LOG_LINES=500
